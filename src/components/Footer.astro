---
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>© {year} {SITE.brand}. All rights reserved.</p>
    <p class="footer-links">
      <a href={SITE.marketingUrl}>{SITE.marketingLabel}</a>
      <span aria-hidden="true">·</span>
      <a href="/rss.xml">RSS</a>
      <span aria-hidden="true">·</span>
      <a href="/tags/">Tags</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border, #ede8da);
    padding: 32px 24px;
    margin-top: 60px;
    background: #ffffff;
  }

  .footer-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    color: #64748b;
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-links a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: #0f172a;
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>
