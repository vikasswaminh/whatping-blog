---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout title="About" description={`About the ${SITE.brand} blog.`}>
  <div class="about-container">
    <article class="post">
      <h1 class="post-title">About</h1>
      <div class="prose">
        <p>Welcome to the {SITE.brand} blog — {SITE.description}</p>
        <p>
          Looking for the product itself? Head to
          <a href={SITE.marketingUrl}>{SITE.marketingLabel}</a>.
        </p>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 800px;
    margin: 64px auto;
    padding: 0 24px;
  }
  .post-title {
    font-size: 40px;
    font-weight: 800;
    margin-bottom: 24px;
    color: #0f172a;
    letter-spacing: -0.02em;
  }
  .prose {
    font-size: 18px;
    line-height: 1.6;
    color: #475569;
  }
  .prose p {
    margin-bottom: 24px;
  }
  .prose a {
    color: #0f172a;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: #F9B900;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .prose a:hover {
    color: #F9B900;
  }
  @media (max-width: 640px) {
    .about-container {
      margin: 40px auto;
      padding: 0 16px;
    }
    .post-title {
      font-size: 32px;
    }
  }
</style>
